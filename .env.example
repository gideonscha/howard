# ── Kill-switch ──────────────────────────────────────────────
# Master gate. While "false", send/followup log would-be sends and exit.
SENDING_ENABLED=false

# ── Supabase (project: partner-hunter / nrxmuhciadrqprmnwvmp) ─
SUPABASE_URL=https://nrxmuhciadrqprmnwvmp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── AgentMail ────────────────────────────────────────────────
AGENTMAIL_API_KEY=
# Set after running scripts/setup-agentmail.ts (webhook signing secret, whsec_...)
AGENTMAIL_WEBHOOK_SECRET=
HOWARD_INBOX=howard@magicportraitspartners.com

# ── Scraping / enrichment ────────────────────────────────────
FIRECRAWL_API_KEY=
# Per-run credit budget for discover (JSON-extraction pages ≈ 5 credits each)
FIRECRAWL_RUN_CREDIT_BUDGET=1000
ZEROBOUNCE_API_KEY=
# Optional — only needed for the Google Places review-mining source (vet segment)
GOOGLE_PLACES_API_KEY=

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Shopify (custom app Admin token; scopes: read_orders, read_discounts, write_discounts)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# ── Sending policy ───────────────────────────────────────────
DAILY_SEND_CAP=10
FOLLOWUP_DELAYS_DAYS=4,9
# CAN-SPAM physical postal address, shown in every email footer
POSTAL_ADDRESS=
# Public base URL of this deployment (for unsubscribe + self-demo links)
PUBLIC_BASE_URL=
# Magic Portraits free-preview funnel URL (primary CTA in drafts)
SELF_DEMO_URL=

# ── Auth ─────────────────────────────────────────────────────
# Protects the dashboard (HTTP Basic) and /api/run/* (Bearer CRON_SECRET)
DASHBOARD_USER=gideon
DASHBOARD_PASSWORD=
CRON_SECRET=
# HMAC secret for unsubscribe tokens (any long random string)
UNSUBSCRIBE_SECRET=
